# NINA Advanced API MCP - Configuration
# Copy this file to .env and fill in your values

# Address of the machine running NINA (use localhost if on same machine)
NINA_HOST=localhost

# NINA Advanced API plugin port (default 1888)
NINA_PORT=1888

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory where captured image thumbnails will be saved
IMAGE_SAVE_DIR=C:/Users/YOUR_USERNAME/Pictures/NINA
